{
  "app": {
    "name": "OVIS - 개인화 AI 에이전트 시스템",
    "version": "0.1.0",
    "environment": "production",
    "log_level": "info"
  },
  "api": {
    "host": "0.0.0.0",
    "port": 528,
    "prefix": "/api/v1",
    "cors_origins": ["*"]
  },
  "ui": {
    "port": 3000,
    "dev_server": true
  },
  "nas": {
    "path": "./data",
    "cache_size": "1GB",
    "timeout": 5000,
    "retry_attempts": 3,
    "directory_structure": {
      "models": "models",
      "data": "data",
      "logs": "logs"
    }
  },
  "agents": {
    "available": ["alpha", "beta", "theta"],
    "default": "alpha",
    "auto_start": false
  },
  "logging": {
    "file": {
      "enabled": true,
      "path": "/app/logs/ovis.log",
      "max_size": "10MB",
      "max_files": 5
    },
    "nas": {
      "enabled": true,
      "path": "logs/system"
    },
    "console": {
      "enabled": true,
      "level": "info"
    },
    "metrics": {
      "enabled": true,
      "interval": 60
    }
  },
  "security": {
    "encryption_key": "",
    "require_authentication": false
  },
  "system": {
    "resource_limits": {
      "memory": "4GB",
      "cpu_percent": 80
    },
    "check_updates": true,
    "auto_update": false,
    "temp_directory": "/tmp/ovis"
  }
} 